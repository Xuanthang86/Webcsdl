{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webcsdlkhcn-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khcn-portal-staging",
      "database_id": "a808e381-b2c8-4c9a-a943-334077198c3a"
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "PORTAL_NAME": "Cổng dữ liệu KHCN & KNĐMST TP Đà Nẵng (Staging)",
    "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/danangsokhcn"
  }
}
