{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "danang-sokhcn-portal",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "danang-sokhcn-d1",
      "database_id": "danang-sokhcn-prod-id"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PORTAL_NAME": "Cổng dữ liệu KHCN & KNĐMST TP Đà Nẵng",
    "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/danangsokhcn"
  }
}
